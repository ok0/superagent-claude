{
  "name": "superagent-claude",
  "version": "0.1.0",
  "description": "A proactive agent for GitHub repositories. Powered by Claude.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "superagent-claude": "lib/cli.js"
  },
  "files": [
    "lib",
    "prompts",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('node:fs').chmodSync('lib/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:seed": "SUPERAGENT_CLAUDE_SEED_INSTALL=1 vitest run tests/live-ui-scenarios.spec.ts tests/live-extended-scenarios.spec.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm check:branding && pnpm check:commits",
    "check:commits": "node scripts/check-commits.ts",
    "check:branding": "node scripts/check-branding.ts",
    "live:seed": "node tests/live/seed-playground.ts",
    "live:cleanup": "node tests/live/cleanup-playground.ts",
    "spike:sdk": "node spikes/sdk/run.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.28.11",
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  }
}
